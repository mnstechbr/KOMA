{
  "name": "koma",
  "version": "0.4.57",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bash ./scripts/dev-next.sh",
    "dev:web": "next dev -p 3080",
    "dev:local": "npm run dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "security:deps": "node ./scripts/dependency-risk-check.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:install": "bash scripts/install-desktop.sh",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "test:quality": "KOMA_QUALITY=1 KOMA_QUALITY_SET=tests/quality-pages.json vitest run tests/quality.real.test.ts",
    "desktop:resources": "node scripts/fetch-desktop-resources.mjs",
    "desktop:rpm": "node scripts/build-rpm.mjs",
    "desktop:windows": "node scripts/build-windows.mjs",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "acorn": "8.15.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "htmlparser2": "^10.1.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.7",
    "onnxruntime-node": "^1.27.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.32.6",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.1",
    "@tailwindcss/oxide-wasm32-wasi": "^4.2.1"
  },
  "overrides": {
    "postcss": "8.5.10",
    "protobufjs": "7.6.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.10",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.8.2"
}
